# Copy to .env and fill in. Never commit .env.
# The names are provisional until the lanes are scaffolded; the values come from the team chat.

# Solana (devnet only)
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=

# Supabase (one shared cloud project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server side only. Never in the browser, never in a NEXT_PUBLIC_ or VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Firecrawl (server side only)
FIRECRAWL_API_KEY=

# ElevenLabs (server side only)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
